# ============================================================================
# TRACE-X MEMORY - Backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Application ---
APP_NAME=TRACE-X MEMORY
ENVIRONMENT=development
DEBUG=true
API_DOCS_ENABLED=true

# --- Database ---------------------------------------------------------------
# Zero-config local development (SQLite):
DATABASE_URL=sqlite:///./tracex.db
# Production (docker-compose provides a `postgres` service):
# DATABASE_URL=postgresql+psycopg://tracex:tracex@localhost:5432/tracex

# --- Authentication ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_REGISTRATION=true

# --- CORS (comma separated origins, or * for all) ---------------------------
CORS_ORIGINS=*

# --- Storage ----------------------------------------------------------------
EVIDENCE_STORAGE_PATH=./storage/evidence
REPORT_STORAGE_PATH=./storage/reports
TEMP_STORAGE_PATH=./storage/temp
MAX_UPLOAD_SIZE_BYTES=209715200

# --- Forensic process execution safety --------------------------------------
TOOL_TIMEOUT_SECONDS=300
MAX_TOOL_OUTPUT_BYTES=5000000

# --- Forensic tool paths (leave empty to auto-detect on PATH) ---------------
TSHARK_PATH=
ZEEK_PATH=
YARA_PATH=
YARA_RULES_PATH=

# --- Velociraptor (optional) ------------------------------------------------
VELOCIRAPTOR_URL=
VELOCIRAPTOR_API_KEY=

# --- SIEM / EDR (optional) --------------------------------------------------
SIEM_URL=
SIEM_API_KEY=
SIEM_TYPE=

# --- Kimi K3 (explanation layer only - NOT a source of truth) ---------------
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# --- Startup behaviour ------------------------------------------------------
AUTO_CREATE_TABLES=true
SEED_DEMO_ON_STARTUP=false